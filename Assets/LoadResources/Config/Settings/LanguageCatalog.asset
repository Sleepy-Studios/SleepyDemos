    fontId: 0
    chinese: "\u5E94\u7528\u97F3\u91CF\u540E\u4FDD\u7559\u64AD\u653E\u8FDB\u5EA6\uFF0C\u9759\u97F3\u4E0D\u4F1A\u505C\u6B62\u58F0\u97F3\u3002"
