  - key: Settings.HelpGraphics
    fontId: 0
    chinese: "\u5F00\u542F DLSS / DLAA \u540E\u7531\u5B83\u63A5\u7BA1\u6297\u952F\u9F7F\uFF0C\u5173\u95ED\u540E\u6062\u590D\u624B\u52A8\u9009\u62E9\u3002"
