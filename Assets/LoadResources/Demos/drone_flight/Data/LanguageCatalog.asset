  - key: Input.Drone.TakeoffPanel
    fontId: 0
    chinese: "\u81EA\u52A8\u8D77\u98DE \xB7 \u64CD\u4F5C\u9762\u677F"
    english: "Auto takeoff \xB7 operation panel"
  - key: Input.Drone.LandingPanel
    fontId: 0
    chinese: "\u81EA\u52A8\u964D\u843D \xB7 \u64CD\u4F5C\u9762\u677F"
    english: "Auto landing \xB7 operation panel"
  - key: Input.Drone.ProfileCinePanel
    fontId: 0
    chinese: "\u5E73\u7A33\u6A21\u5F0F \xB7 \u64CD\u4F5C\u9762\u677F"
    english: "Cinematic profile \xB7 operation panel"
  - key: Input.Drone.ProfileNormalPanel
    fontId: 0
    chinese: "\u666E\u901A\u6A21\u5F0F \xB7 \u64CD\u4F5C\u9762\u677F"
    english: "Normal profile \xB7 operation panel"
  - key: Input.Drone.ProfileSportPanel
    fontId: 0
    chinese: "\u8FD0\u52A8\u6A21\u5F0F \xB7 \u64CD\u4F5C\u9762\u677F"
    english: "Sport profile \xB7 operation panel"
  - key: Input.Drone.AimPad
    fontId: 0
    chinese: "\u673A\u8179\u7784\u51C6 \xB7 \u955C\u5934\u6A21\u5F0F\u4E0B\u8C03\u6574\u51C6\u661F"
    english: "Belly aim \xB7 adjust reticle with camera modifier"
  - key: Input.Drone.AimMouse
    fontId: 0
    chinese: "\u673A\u8179\u7784\u51C6 \xB7 \u9F20\u6807\u79FB\u52A8\u51C6\u661F"
    english: "Belly aim \xB7 move mouse to aim"
  - key: Input.Drone.ResetHoldDuration
    fontId: 0
    chinese: "\u957F\u6309 {0:0.#} \u79D2\u91CD\u65B0\u8FD0\u884C\u573A\u666F"
    english: Hold {0:0.#} seconds to restart the scene
  - key: Input.Drone.TouchFlight
    fontId: 0
    chinese: "<color=#F4A23A>\u5DE6\u6447\u6746</color>  \u4E0A\u4E0B\u5347\u964D
      / \u5DE6\u53F3\u504F\u822A\n\n<color=#F4A23A>\u53F3\u6447\u6746</color>  \u524D\u540E
      / \u5DE6\u53F3\u5E73\u79FB"
    english: "<color=#F4A23A>Left stick</color>  Vertical: lift / descend \xB7 Horizontal:
      yaw\n\n<color=#F4A23A>Right stick</color>  Move forward / backward / sideways"
  - key: Input.Drone.TouchCamera
    fontId: 0
    chinese: "\u5207\u6362\u955C\u5934 \xB7 \u955C\u5934\u6A21\u5F0F\u4E0B\u7528\u53F3\u6447\u6746\u8C03\u6574\u955C\u5934\n\u7F29\u653E\u89C6\u91CE
      \xB7 \u8D77\u843D\u67B6\u6536\u653E"
    english: "Switch camera \xB7 hold camera modifier and use the right stick to
      look\nZoom \xB7 toggle landing gear"
  - key: Input.Drone.TouchFlightCommands
    fontId: 0
    chinese: "\u786E\u8BA4\u6309\u94AE\uFF1A\u89E3\u9501 / \u9501\u5B9A\n\u64CD\u4F5C\u9762\u677F\uFF1A\u81EA\u52A8\u8D77\u98DE
      / \u964D\u843D\n\u64CD\u4F5C\u9762\u677F\uFF1A\u5E73\u7A33 / \u666E\u901A /
      \u8FD0\u52A8"
    english: 'Confirm button: arm / disarm

      Operation panel: auto takeoff /
      landing

      Operation panel: cinematic / normal / sport'
  - key: Input.Drone.TouchGrapple
    fontId: 0
    chinese: "<b>\u56DB\u722A\u6293\u6597</b>\n\u88C5\u5907\u6309\u94AE\uFF1A\u56DB\u722A\u5F00\u5408\n\u6536\u7EBF
      / \u653E\u7EBF\u6309\u94AE\uFF1A\u4E0A\u6536 / \u4E0B\u653E"
    english: '<b>Four-claw grapple</b>

      Equipment button: open / close claws

      Reel
      in / pay out buttons: raise / lower'
  - key: Input.Drone.TouchHarpoon
    fontId: 0
    chinese: "<b>\u6E14\u53C9</b>\n\u7784\u51C6\u6309\u94AE\uFF1A\u673A\u8179\u7784\u51C6\n\u88C5\u5907\u6309\u94AE\uFF1A\u53D1\u5C04
      / \u89E3\u9664\u56DE\u6536\n\u6536\u7EBF / \u653E\u7EBF\u6309\u94AE\uFF1A\u6536\u7EBF
      / \u653E\u7EBF\n\u955C\u5934\u6A21\u5F0F\u4E0B\u7528\u53F3\u6447\u6746\u8C03\u6574\u51C6\u661F"
    english: '<b>Harpoon</b>

      Aim button: belly aim

      Equipment button:
      fire / detach & recover

      Reel in / pay out buttons: reel in / pay out

      Hold
      camera modifier and use the right stick to adjust the reticle'
  - key: Input.Drone.NoEquipmentHelp
    fontId: 0
    chinese: "<b>\u7EAF\u65E0\u4EBA\u673A</b>\n\n\u672A\u5B89\u88C5\u9644\u52A0\u88C5\u5907\n\u66F4\u6362\u673A\u578B\u53EF\u4F7F\u7528\u6293\u6597\u6216\u6E14\u53C9"
    english: '<b>Plain drone</b>


      No equipment installed

      Choose another
      model to use a grapple or harpoon'
  - key: Input.Drone.TouchResetHoldDuration
    fontId: 0
    chinese: "\u957F\u6309\u786E\u8BA4\u6309\u94AE {0:0.#} \u79D2\u91CD\u65B0\u8FD0\u884C\u573A\u666F"
    english: Hold the confirm button for {0:0.#} seconds to restart the scene
  - key: Input.Drone.ReturnPanel
    fontId: 0
    chinese: "\u8FD4\u56DE\u64CD\u4F5C\u9762\u677F"
    english: Return to operation panel
  - key: Input.Drone.ReturnFlight
    fontId: 0
    chinese: "\u8FD4\u56DE\u98DE\u884C"
    english: Return to flight
