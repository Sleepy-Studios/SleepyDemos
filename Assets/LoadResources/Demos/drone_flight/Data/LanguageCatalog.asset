  - key: Input.Drone.FlightAxes
    fontId: 0
    chinese: "\u6C34\u5E73\u79FB\u52A8 \xB7 \u5347\u964D / \u504F\u822A"
    english: "Horizontal movement \xB7 vertical / yaw"
  - key: Input.Drone.CameraLook
    fontId: 0
