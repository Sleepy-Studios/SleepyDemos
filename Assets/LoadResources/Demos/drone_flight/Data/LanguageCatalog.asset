  - key: Input.Drone.HarpoonControls
    fontId: 0
    chinese: "\u673A\u8179\u7784\u51C6 \xB7 \u53D1\u5C04 / \u89E3\u9664\u56DE\u6536
      \xB7 \u6536\u7EBF / \u653E\u7EBF"
    english: "Belly aim \xB7 Fire / detach & recover \xB7 Reel in / pay out"
  - key: Input.Drone.SelectTouch
    fontId: 0
    chinese: "\u70B9\u51FB\u673A\u578B\u67E5\u770B \xB7 \u70B9\u51FB\u5F00\u59CB\u98DE\u884C"
    english: "Tap a model to preview \xB7 tap Start flight"
  - key: Input.Drone.HorizontalMove
    fontId: 0
    chinese: "\u6C34\u5E73\u79FB\u52A8"
