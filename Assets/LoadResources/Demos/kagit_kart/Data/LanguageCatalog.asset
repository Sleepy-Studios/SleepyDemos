  entries:
  - key: Input.KagitKart
    fontId: 0
    chinese: "\u7EB8\u827A\u5361\u4E01\u8F66"
    english: Paper Kart
  - key: Input.Kart.DriftSteer
    fontId: 0
    chinese: "\u6F02\u79FB \xB7 \u6309\u4F4F\u5E76\u8F6C\u5411"
    english: "Drift \xB7 hold and steer"
  - key: Input.Kart.ItemBackward
    fontId: 0
    chinese: "\u9053\u5177 \xB7 \u6309\u4F4F\u5239\u8F66\u53EF\u5411\u540E\u53D1\u5C04"
    english: "Item \xB7 hold brake to fire backward"
  - key: Input.Kart.UseItemBackward
    fontId: 0
    chinese: "\u4F7F\u7528\u9053\u5177 \xB7 \u6309\u4F4F\u5239\u8F66\u53EF\u5411\u540E\u53D1\u5C04"
    english: "Use item \xB7 hold brake to fire backward"
  - key: Input.Kart.TimeTrialRestart
    fontId: 0
    chinese: "\u8BA1\u65F6\u8D5B\u5FEB\u6377\u91CD\u8D5B"
    english: Quick time trial restart
  - key: Input.Kart.TouchThrottle
    fontId: 0
    chinese: "\u6309\u4F4F\u201C\u6CB9\u95E8\u201D\uFF0C\u6216\u5F00\u542F\u81EA\u52A8\u6CB9\u95E8"
    english: Hold Throttle or enable auto throttle
  - key: Input.Kart.TouchBrake
    fontId: 0
    chinese: "\u6309\u4F4F\u201C\u5239\u8F66\u201D"
    english: Hold Brake
  - key: Input.Kart.TouchDrift
    fontId: 0
    chinese: "\u6309\u4F4F\u201C\u6F02\u79FB\u201D\u5E76\u8F6C\u5411"
    english: Hold Drift and steer
  - key: Input.Kart.TouchItem
    fontId: 0
    chinese: "\u8F7B\u89E6\u201C\u9053\u5177\u201D\uFF1B\u6309\u4F4F\u5239\u8F66\u518D\u4F7F\u7528\u53EF\u5411\u540E\u53D1\u5C04"
    english: Tap Item; hold Brake while using it to fire backward
  - key: Input.Kart.TouchItemCard
    fontId: 0
    chinese: "\u8F7B\u89E6\u201C\u9053\u5177\u201D\u6216\u9053\u5177\u5361"
    english: Tap Item or the item card
  - key: Input.Kart.TouchLookBack
    fontId: 0
    chinese: "\u6309\u4F4F\u201C\u56DE\u5934\u201D"
    english: Hold Look back
  - key: Input.Kart.TouchPause
    fontId: 0
    chinese: "\u8F7B\u89E6\u753B\u9762\u4E0A\u7684\u201C\u6682\u505C\u201D\u6309\u94AE"
    english: Tap the Pause button
  - key: Input.Kart.TouchMute
    fontId: 0
    chinese: "\u8BBE\u7F6E \u2192 \u58F0\u97F3"
    english: "Settings \u2192 Audio"
  - key: Input.Kart.TouchRestart
    fontId: 0
    chinese: "\u6682\u505C \u2192 \u91CD\u65B0\u5F00\u59CB"
    english: "Pause \u2192 Restart"
  - key: Input.Kart.HintCorner
    fontId: 0
    chinese: "\u6F02\u79FB\uFF1A\u6309\u4F4F\u201C\u6F02\u79FB\u201D\u5E76\u8F6C\u5411"
    english: 'Drift: hold Drift and steer'
  - key: Input.Kart.HintTier
    fontId: 0
    chinese: "\u51FA\u73B0\u706B\u82B1\uFF1A\u677E\u5F00\u201C\u6F02\u79FB\u201D
      \u2192 \u52A0\u901F"
    english: "Sparks appear: release Drift \u2192 boost"
  - key: Input.Kart.HintRamp
    fontId: 0
    chinese: "\u5728\u8DF3\u53F0\u8FB9\u7F18\u6309\u4E0B\u201C\u6F02\u79FB\u201D"
    english: Press Drift at the edge of a ramp
  - key: Input.Kart.HintItem
    fontId: 0
    chinese: "\u8F7B\u89E6\u201C\u9053\u5177\u201D\u4F7F\u7528\uFF1B\u6309\u4F4F\u201C\u5239\u8F66\u201D\u518D\u4F7F\u7528\u53EF\u5411\u540E\u53D1\u5C04"
    english: Tap Item to use it; hold Brake to fire backward
  - key: Input.Kart.HintPortrait
    fontId: 0
    chinese: "\u628A\u624B\u673A\u6A2A\u8FC7\u6765\uFF0C\u4F53\u9A8C\u66F4\u597D"
    english: Rotate your phone to landscape for a better experience
  - key: Input.Kart.HintCornerPhysical
    fontId: 0
    chinese: "\u6F02\u79FB\uFF1A\u6309\u4F4F\u5E76\u8F6C\u5411"
    english: 'Drift: hold and steer'
  - key: Input.Kart.HintTierPhysical
    fontId: 0
    chinese: "\u51FA\u73B0\u706B\u82B1\uFF1A\u677E\u5F00\u6F02\u79FB \u2192 \u52A0\u901F"
    english: "Sparks appear: release drift \u2192 boost"
  - key: Input.Kart.HintRampPhysical
    fontId: 0
    chinese: "\u5728\u8DF3\u53F0\u8FB9\u7F18\u6309\u4E0B\u6F02\u79FB"
    english: Press drift at the edge of a ramp
  - key: Input.Kart.HintItemPhysical
    fontId: 0
    chinese: "\u4F7F\u7528\u9053\u5177\uFF1B\u6309\u4F4F\u5239\u8F66\u518D\u4F7F\u7528\u53EF\u5411\u540E\u53D1\u5C04"
    english: Use item; hold brake to fire backward
  - key: Input.Kart.ItemButton
    fontId: 0
    chinese: "\u9053\u5177"
    english: Item
  - key: Input.Kart.SkipCinematic
    fontId: 0
    chinese: "\u8DF3\u8FC7\u6F14\u51FA"
    english: Skip cinematic
  - key: Input.Kart.AutoThrottleOn
    fontId: 0
    chinese: "\u81EA\u52A8\u6CB9\u95E8\uFF1A\u5F00"
    english: 'Auto throttle: On'
  - key: Input.Kart.AutoThrottleOff
    fontId: 0
    chinese: "\u81EA\u52A8\u6CB9\u95E8\uFF1A\u5173"
    english: 'Auto throttle: Off'
  - key: Input.Kart.TouchSteer
    fontId: 0
    chinese: "\u6309\u4F4F\u5DE6\u8F6C\u6216\u53F3\u8F6C\u6309\u94AE\uFF1B\u677E\u5F00\u56DE\u6B63"
    english: Hold Left or Right to steer; release to straighten
  - key: Input.Kart.TouchLeft
    fontId: 0
    chinese: "\u2190"
    english: "\u2190"
  - key: Input.Kart.TouchRight
    fontId: 0
    chinese: "\u2192"
    english: "\u2192"
